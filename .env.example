# Copy this file to .env and set a real key for live DeepSeek execution.
DEEPSEEK_API_KEY=

# Current DeepSeek models supporting tool calls (verify against official docs):
#   deepseek-flash
#   deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Agent / client options.
AGENT_MAX_ITERATIONS=10
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=6000
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_DISABLE_THINKING=true
TRACE_DIR=traces
